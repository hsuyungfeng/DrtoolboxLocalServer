{
  "chroma": {
    "type": "persistant",
    "path": "data/rag/chroma/",
    "collections": {
      "general": "general",
      "special": "special"
    },
    "default_collection": "general"
  },
  "document_folders": {
    "general": "data/documents/general/",
    "special": "data/documents/special/"
  },
  "chunking": {
    "chunk_size": 512,
    "chunk_overlap": 50,
    "min_chunk_size": 100,
    "max_chunk_size": 1024
  },
  "embedding": {
    "model": "BAAI/bge-m3",
    "device": "cpu",
    "batch_size": 32
  },
  "supported_formats": [
    ".txt",
    ".pdf",
    ".docx",
    ".json"
  ],
  "ingestion": {
    "max_file_size_mb": 50,
    "timeout_seconds": 120,
    "skip_large_files": true
  },
  "search": {
    "default_n_results": 5,
    "max_n_results": 20,
    "min_relevance_score": 0.3
  },
  "metadata": {
    "track_source": true,
    "track_page": true,
    "track_section": true,
    "track_ingestion_time": true
  }
}